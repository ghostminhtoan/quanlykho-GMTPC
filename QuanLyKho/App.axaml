<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:QuanLyKho"
             x:Class="QuanLyKho.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- Global Dark TextBox Styling -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="CaretBrush" Value="#38BDF8" />
            <Setter Property="SelectionBrush" Value="#2563EB" />
            <Setter Property="SelectionForegroundBrush" Value="#FFFFFF" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#64748B" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Foreground" Value="#F8FAFC" />
        </Style>

        <!-- Global Dark NumericUpDown Styling -->
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="NumericUpDown:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#64748B" />
        </Style>
        <Style Selector="NumericUpDown:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <!-- ButtonSpinner inside NumericUpDown -->
        <Style Selector="ButtonSpinner">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#475569" />
        </Style>
    </Application.Styles>
</Application>
